# Web image: nginx serving the Laravel public/ tree and proxying PHP to the
# `app` service over fastcgi. Public assets (and the Vite build output) are
# baked in so the image is self-contained — no shared volumes needed for
# Swarm scheduling.

FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY public/ /var/www/public/
COPY --from=frontend-builder /app/public/build /var/www/public/build
COPY docker/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
