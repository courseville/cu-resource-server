# Production env template for `docker stack deploy -c docker-stack.yml`.
#
# These variables are interpolated into docker-stack.yml at deploy time
# (load via `set -a; . .env.production; set +a` before `docker stack deploy`).
#
# All SENSITIVE values (APP_KEY, DB_PASSWORD, REDIS_PASSWORD, OAuth keys,
# Passport personal access client secret) are NOT here — they are stored as
# Docker Swarm secrets. See docker-stack.yml for the `docker secret create`
# commands.

# Container images — built locally, pushed to a private registry (e.g. ghcr.io),
# pulled by the swarm at deploy time. Use immutable tags (commit SHA or version)
# rather than `latest` so rollbacks work.
APP_IMAGE=ghcr.io/<owner>/mcv-app:latest
WEB_IMAGE=ghcr.io/<owner>/mcv-web:latest

APP_NAME=MCV-Resource-Server
APP_DOMAIN=api.example.com
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Bangkok

# Let's Encrypt registration email (required for ACME).
ACME_EMAIL=ops@example.com

# Database (the password is a Swarm secret; user/db name are not sensitive).
DB_DATABASE=resource_server
DB_USERNAME=mcv

# Passport: the PUBLIC personal access client ID. The secret is a Docker secret.
# Find this with `php artisan passport:keys && php artisan passport:client --personal`.
PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
